# Скопируйте этот файл в .env и замените пароли до первого запуска.
# Пароли и имена: буквы, цифры и символы _ . / + = @ % -
# Пробелы, кавычки, $ и обратный слэш нельзя: они ломают healthcheck брокера.

# Порт MQTT на хосте. Внутри сети compose брокер всегда слушает 1883.
MQTT_PUBLISH_PORT=1883

# Служебный пользователь, под которым воркер прогноза подключается к брокеру.
# Он не предназначен для SCADA. Пароль придумайте длинный.
MQTT_WORKER_USERNAME=forecast-worker
MQTT_WORKER_PASSWORD=change-me-worker

# Демо-клиент для проверки mosquitto_pub / mosquitto_sub.
# Имя становится уровнем топика: forecast/v1/demo-scada/request
DEMO_CLIENT_USERNAME=demo-scada
DEMO_CLIENT_PASSWORD=change-me-demo

# Идентификатор сессии воркера. Менять не нужно, если запущен один экземпляр.
MQTT_CLIENT_ID=forecast-worker
# 0, 1 или 2. Для пилота оставляйте 1: брокер хранит сообщение, пока воркер его не подтвердит.
MQTT_QOS=1
# Секунды между служебными ping воркера. Должны быть меньше таймаута, с которым ждёт брокер.
MQTT_KEEPALIVE=60
# Общий префикс топиков. Запрос: {префикс}/{username}/request
MQTT_TOPIC_PREFIX=forecast/v1

# Модель Hugging Face. Для пилота это amazon/chronos-2.
CHRONOS_MODEL=amazon/chronos-2
# cpu на сервере без GPU, cuda если в образ поставлен CUDA-сборка PyTorch и проброшен GPU.
CHRONOS_DEVICE=cpu
# true: грузить Chronos-2 сразу после подключения к брокеру.
# false: грузить при первом запросе с model chronos-2 или both.
CHRONOS_PRELOAD=true
# Каталог кэша весов внутри контейнера. На него смотрит том hf-cache.
HF_HOME=/opt/hf

# Индекс колёс PyTorch на время сборки образа. Меняется только вместе с пересборкой.
# CPU: https://download.pytorch.org/whl/cpu
# CUDA 12.4: https://download.pytorch.org/whl/cu124
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# Лимиты одного MQTT-сообщения.
MAX_SERIES=8
MAX_POINTS=5000
MAX_HORIZON=512
MIN_POINTS=10
# Сколько запросов ждать в памяти, пока считается текущий.
QUEUE_SIZE=8

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
